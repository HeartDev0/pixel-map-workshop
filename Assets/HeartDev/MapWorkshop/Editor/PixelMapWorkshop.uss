.workshop { background-color: #20262a; color: #e2e8e9; }
.header { flex-direction: row; align-items: center; padding: 9px; background-color: #171d21; border-bottom-width: 1px; border-bottom-color: #3b484c; }
.brand { color: #90d9c1; -unity-font-style: bold; font-size: 15px; margin-right: 18px; }
.row { flex-direction: row; }
.body { flex-direction: row; flex-grow: 1; min-height: 0; }
.settings-panel { width: 248px; min-width: 248px; padding: 9px; background-color: #282f33; }
.section { margin-bottom: 12px; }
.tool-grid { flex-direction: row; flex-wrap: wrap; margin-bottom: 9px; }
.tool-button { width: 105px; height: 34px; margin: 2px; white-space: normal; }
.selected { background-color: #30574f; border-left-color: #8edbc4; border-right-color: #8edbc4; border-top-color: #8edbc4; border-bottom-color: #8edbc4; color: #f2fff8; }
.hint { font-size: 11px; color: #aebdc1; white-space: normal; margin-top: 6px; margin-bottom: 6px; }
.swatches { flex-direction: row; flex-wrap: wrap; margin-bottom: 6px; }
.swatch { width: 65px; height: 29px; margin: 2px; }
.workspace { flex-grow: 1; min-width: 270px; }
.views { flex-direction: row; flex-grow: 1; min-height: 0; }
.view-pane { flex-grow: 1; flex-basis: 0; min-width: 130px; padding: 7px; border-right-width: 1px; border-right-color: #3a464b; }
.view-caption { color: #a9babf; font-size: 10px; margin-bottom: 8px; white-space: normal; }
.assets-panel { width: 266px; min-width: 266px; padding: 10px; background-color: #282f33; }
.asset-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.asset-tile { width: 70px; height: 96px; margin: 3px; padding: 4px; background-color: #1b2429; border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: #415057; border-right-color: #415057; border-top-color: #415057; border-bottom-color: #415057; }
.asset-tile:hover { background-color: #344249; }
.asset-tile.selected { background-color: #30574f; border-left-color: #8edbc4; border-right-color: #8edbc4; border-top-color: #8edbc4; border-bottom-color: #8edbc4; }
.asset-image { width: 58px; height: 61px; }
.asset-name { font-size: 10px; -unity-text-align: middle-center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.selected-image { width: 80px; height: 88px; margin-right: 10px; background-color: #1b2429; }
.selected-name { -unity-font-style: bold; white-space: normal; margin-top: 8px; }
.status { background-color: #171d21; padding: 8px; color: #adc7c5; white-space: normal; }
.primary { background-color: #406f60; color: #ffffff; height: 28px; }
.brush-cursor { position: absolute; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: #ffffff; border-right-color: #ffffff; border-top-color: #ffffff; border-bottom-color: #ffffff; background-color: rgba(255,255,255,0.12); }
.unity-base-field__label { min-width: 92px; max-width: 110px; }
.unity-foldout { margin-top: 8px; margin-bottom: 8px; }
.action-icon { width: 16px; height: 16px; flex-shrink: 0; margin-right: 4px; }
.color-palette-bar { background-color: #1b2227; padding: 7px; border-top-width: 1px; border-top-color: #476058; flex-shrink: 0; }
.palette-colors { flex-direction: row; flex-wrap: wrap; margin-top: 5px; }
.color-chip { width: 26px; height: 26px; min-width: 26px; margin: 2px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: #73817f; border-right-color: #73817f; border-top-color: #73817f; border-bottom-color: #73817f; }
.color-chip:hover { border-left-color: white; border-right-color: white; border-top-color: white; border-bottom-color: white; }
.palette-target { border-bottom-width: 2px; border-bottom-color: #8edbc4; }
.pattern-preview { width: 96px; height: 96px; margin-top: 6px; background-color: #1b2429; }

/* Compact sprite-editor workspace: tool rail, options strip, canvas and layer dock. */
.workshop { background-color: #29282e; color: #e4dfd5; }
.header { padding: 5px 8px; background-color: #242329; border-bottom-color: #121116; }
.brand { color: #edc08a; font-size: 12px; margin-right: 12px; }
.brush-options { padding: 5px 8px; min-height: 32px; flex-shrink: 0; align-items: center; background-color: #3a383f; border-bottom-width: 1px; border-bottom-color: #17161a; }
.brush-options > .row { flex-wrap: wrap; align-items: center; }
.brush-options .unity-base-field__label { min-width: 52px; max-width: 65px; }
.brush-options .unity-toggle { margin-left: 10px; }
.tool-rail { width: 44px; min-width: 44px; padding: 3px; background-color: #343239; border-right-width: 1px; border-right-color: #17161a; }
.tool-button { width: 34px; min-width: 34px; height: 34px; padding: 3px; margin: 2px 0; flex-shrink: 0; border-radius: 0; background-color: #45424b; }
.tool-button Image { width: 26px; height: 26px; }
.settings-panel { width: 280px; min-width: 280px; padding: 8px; background-color: #343239; }
.section { margin-bottom: 8px; }
.hint { color: #b9b3bf; }
.selected { background-color: #796044; border-left-color: #eac086; border-right-color: #eac086; border-top-color: #eac086; border-bottom-color: #eac086; }
.tool-button.selected { background-color: #796044; }
.assets-panel { width: 250px; min-width: 250px; padding: 8px; background-color: #343239; }
.asset-tile { width: 68px; height: 82px; margin: 2px; background-color: #29282e; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; }
.asset-image { width: 56px; height: 51px; }
.selected-image { width: 60px; height: 64px; }
.asset-tile.selected { background-color: #796044; border-left-color: #eac086; border-right-color: #eac086; border-top-color: #eac086; border-bottom-color: #eac086; }
.view-pane { padding: 4px; min-width: 120px; }
.view-caption { margin-bottom: 3px; color: #c0bac8; }
.layer-dock { height: 185px; min-height: 100px; max-height: 260px; flex-shrink: 0; padding: 4px 8px; background-color: #343239; border-top-width: 2px; border-top-color: #17161a; }
.layer-row { flex-direction: row; align-items: center; padding: 2px 4px; border-bottom-width: 1px; border-bottom-color: #29272e; }
.layer-row.active-layer { background-color: #51473d; border-left-width: 3px; border-left-color: #edc08a; }
.layer-row Button { min-width: 26px; height: 23px; }
.layer-row .unity-toggle { flex-shrink: 0; }
.color-palette-bar { background-color: #29272e; padding: 5px 8px; border-top-color: #5d5664; }
.color-chip { width: 23px; height: 23px; min-width: 23px; margin: 1px; border-radius: 0; }
.palette-target { border-bottom-color: #edc08a; }
.status { background-color: #242329; color: #c3bacb; padding: 4px 8px; font-size: 11px; }
.primary { background-color: #716049; }
.action-icon { flex-shrink: 0; }
.canvas-divider { width: 8px; min-width: 8px; flex-shrink: 0; justify-content: center; align-items: center; background-color: #4b4651; cursor: resize-horizontal; }
.canvas-divider:hover, .canvas-divider.dragging { background-color: #a58157; }
.canvas-divider Label { color: #edc08a; font-size: 16px; }
.settings-panel .unity-base-field__label { min-width: 100px; max-width: 110px; }
.left-sidebar { width: 280px; min-width: 280px; flex-shrink: 0; background-color: #343239; }
.left-sidebar .settings-panel { width: auto; min-width: 0; flex-grow: 1; min-height: 0; }
.left-sidebar .color-palette-bar { height: 32%; min-height: 230px; max-height: 370px; padding: 6px 8px; }
.left-sidebar .color-palette-bar .row { flex-wrap: wrap; }
.left-sidebar .color-chip { width: 25px; height: 25px; min-width: 25px; }
.right-sidebar { width: 250px; min-width: 250px; flex-shrink: 0; }
.right-sidebar .assets-panel { width: auto; min-width: 0; flex-grow: 1; flex-basis: 0; min-height: 220px; }
.right-sidebar .layer-dock { height: 36%; min-height: 230px; max-height: 440px; padding: 5px; }
.layer-row { min-height: 27px; padding: 2px 0; }
.layer-grip { width: 18px; min-width: 18px; color: #edc08a; font-size: 17px; cursor: move-arrow; }
.layer-action { width: 30px; height: 27px; padding: 3px; margin-right: 3px; }
.layer-action Image { width: 20px; height: 20px; }
.layer-row.drop-above { border-top-width: 2px; border-top-color: #edc08a; }
.layer-row.drop-below { border-bottom-width: 2px; border-bottom-color: #edc08a; }
.brush-cursor { border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; background-color: rgba(0,0,0,0); }
.brush-shapes { flex-direction: row; margin-left: 6px; flex-shrink: 0; }
.brush-shape-button { width: 30px; height: 29px; min-width: 30px; padding: 2px; margin: 0 1px; }
.brush-shape-button Image { width: 24px; height: 24px; }
.minimap-viewport { position: absolute; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: #ffe7a0; border-right-color: #ffe7a0; border-top-color: #ffe7a0; border-bottom-color: #ffe7a0; background-color: rgba(255,228,150,.15); }
.history-entry { color: #c4bccb; font-size: 10px; white-space: normal; margin-bottom: 3px; }
.dirty-indicator { min-width: 88px; color: #edc08a; font-size: 11px; margin-right: 8px; }
.header { flex-wrap: wrap; }

/* Keep the gallery and prop inspector independent; neither can squash the other. */
.right-sidebar { width: 300px; min-width: 280px; min-height: 0; }
.props-split { flex-grow: 1; min-height: 0; }
.right-sidebar .assets-panel { flex-grow: 0; flex-shrink: 0; flex-basis: auto; min-height: 180px; overflow: hidden; }
.sprite-gallery-scroll { min-height: 60px; }
.assets-panel > .row { flex-shrink: 0; flex-wrap: wrap; align-items: center; min-height: 28px; }
.prop-details { min-height: 160px; background-color: #343239; }
.prop-details .unity-scroll-view__content-container { padding: 8px; }
.prop-details .section { flex-shrink: 0; margin-bottom: 14px; }
.selected-prop-row { min-height: 76px; flex-shrink: 0; align-items: center; }
.selected-prop-row .selected-image { width: 64px; min-width: 64px; height: 64px; flex-shrink: 0; margin-right: 10px; }
.selected-prop-row .selected-name { margin-top: 0; white-space: normal; }
.selected-prop-row .hint { margin-top: 4px; margin-bottom: 0; }
.flower-rotation-section .unity-slider { min-height: 28px; margin-top: 6px; margin-bottom: 2px; }
.flower-rotation-section .unity-base-slider__text-field { width: 50px; min-width: 50px; flex-shrink: 0; }
.right-sidebar .layer-dock { height: auto; min-height: 0; max-height: 99999px; flex-shrink: 0; padding: 0; border-top-width: 1px; }
.layer-toolbar { flex-direction: row; min-height: 38px; flex-wrap: nowrap; align-items: center; justify-content: flex-start; }
.layer-action { width: 32px; min-width: 32px; height: 32px; flex-shrink: 0; padding: 4px; align-items: center; justify-content: center; }
.layer-action .action-icon { width: 20px; height: 20px; margin-right: 0; flex-shrink: 0; }
.layer-row { min-height: 28px; flex-shrink: 0; }
.layer-row .unity-toggle { width: 18px; min-width: 18px; margin-left: 0; margin-right: 2px; flex-shrink: 0; }
.layer-row .unity-text-field { min-width: 60px; }

/* Authoring sections remain readable when the workspace is resized. */
.settings-panel .unity-foldout { flex-shrink: 0; }
.settings-panel .unity-foldout > .unity-foldout__content { padding-left: 3px; }
.settings-panel Button { min-height: 26px; white-space: normal; }
.settings-panel .unity-vector2-int-field { flex-direction: column; align-items: stretch; }
.settings-panel .unity-vector2-int-field > .unity-base-field__label { max-width: none; }
.header > .unity-object-field { min-width: 180px; }
.tool-rail { overflow: hidden; }

.ambient-preset-card { width: 74px; min-width: 70px; height: 66px; flex-shrink: 0; margin: 2px; padding: 3px; }
.ambient-preset-card Label { font-size: 10px; white-space: normal; -unity-text-align: middle-center; }
.settings-panel .unity-vector3-field { flex-direction: column; align-items: stretch; }
.settings-panel .unity-vector3-field > .unity-base-field__label { max-width: none; }

/* Layer visibility and edit locks use the same SVG palette as the tool rail. */
.layer-row .layer-state-toggle { width: 28px; min-width: 28px; height: 26px; margin: 0 2px 0 0; padding: 0; align-items: center; justify-content: center; }
.layer-state-toggle .unity-toggle__input { width: 26px; min-width: 26px; height: 26px; padding: 2px; margin: 0; align-items: center; justify-content: center; background-color: rgba(0,0,0,0); }
.layer-state-icon { width: 22px; height: 22px; flex-shrink: 0; }
.layer-state-toggle:hover { background-color: #4c474f; }
.layer-state-toggle:focus { border-bottom-width: 1px; border-bottom-color: #edc08a; }
